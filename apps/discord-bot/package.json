{
  "name": "@pfq/discord-bot",
  "version": "1.0.0",
  "description": "Discord bot for PFQ moderation",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "deploy-cmds": "tsx scripts/deploy-commands.ts",
    "deploy-cmds:prod": "tsx scripts/deploy-commands.ts --prod",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts --minify",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.1",
    "mysql2": "^3.15.0",
    "node-fetch": "^3.3.2",
    "@pfq/shared": "workspace:*",
    "@pfq/types": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
