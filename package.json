{
  "name": "pfq-monorepo",
  "version": "1.0.0",
  "description": "PFQ Discord Bot, API, and Dashboard Monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "discord:dev": "pnpm --filter discord dev",
    "discord:deploy-cmds": "pnpm --filter discord deploy-cmds",
    "discord:deploy-cmds:prod": "pnpm --filter discord deploy-cmds:prod",
    "discord:start": "pnpm --filter discord start",
    "discord:build": "pnpm --filter discord build",
    "discord:clean": "pnpm --filter discord clean",
    "discord:type-check": "pnpm --filter discord type-check",
    "web:dev": "pnpm --filter dashboard dev",
    "web:build": "pnpm --filter dashboard build",
    "web:start": "pnpm --filter dashboard start",
    "web:lint": "pnpm --filter dashboard lint"
  },
  "devDependencies": {
    "@turbo/gen": "^1.10.12",
    "prettier": "^3.6.2",
    "turbo": "^1.10.12",
    "typescript": "^5.9.2"
  },
  "engines": {
    "pnpm": ">=8.0.0",
    "npm": "0"
  },
  "engineStrict": true
}